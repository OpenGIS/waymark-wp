# Video narration environment.
#
# Copy this file to .env in the repository root and fill in your own values.
# .env is gitignored; never commit it. The TTS script loads it when present but
# does not require it.
#
# Deepgram API key. When set, Deepgram becomes the default provider.
DEEPGRAM_API_KEY=

# Deepgram region: eu, au or in. Leave unset for the US endpoint.
# DEEPGRAM_REGION=eu

# Optional full base URL override, useful for a local test server.
# DEEPGRAM_BASE_URL=http://localhost:11005

# Force a provider: say or deepgram. When unset, Deepgram is used if a key is
# available, otherwise the macOS say voice.
# VIDEO_TTS_PROVIDER=deepgram

# Voice override. Defaults are flux-kit-en for Deepgram and Daniel for say.
# VIDEO_TTS_VOICE=flux-kit-en

# Pace guard. A take outside the band is retried by re-rolling at the default
# rate before any rate nudge. Defaults: 165 wpm target, 10 wpm band and
# 4 attempts per scene.
# VIDEO_TTS_TARGET_WPM=165
# VIDEO_TTS_PACE_BAND_WPM=10
# VIDEO_TTS_MAX_ATTEMPTS=4
