#: inc/Admin/Waymark_Settings.php:60
#. translators: The description of the section for adding Basemaps
msgid ""
"<span class=\"waymark-lead\">Waymark uses the excellent <a "
"href=\"%1$s\">OpenStreetMap</a> as its default Basemap and supports many <a "
"href=\"%2$s\">other providers</a>.<br /><br /><a "
"href=\"%3$s\">Thunderforest</a> and <a href=\"%4$s\">Mapbox</a> are "
"examples of providers that offer easy access to beautiful Basemaps "
"(including satellite imagery). They require registration, but have a free "
"usage tier."
